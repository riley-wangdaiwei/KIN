# Copy to .env.local. Configure a verified sender address with Resend.
RESEND_API_KEY=
KIN_FROM_EMAIL=re.KIN <hello@r3kin.info>
KIN_ORDERS_EMAIL=
KIN_INBOX_EMAIL=teams@r3kin.info

# Server-only Supabase service role key; used to sign images in shared canvases.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: partner landing page for flowers. Orders can also enter at
# /order?source=partner&filling=flowers.
NEXT_PUBLIC_FLOWER_PARTNER_URL=

# Supabase email-only authentication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
